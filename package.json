{
  "name": "kiro-remote-bridge",
  "displayName": "Kiro Remote Bridge",
  "description": "在手机上浏览与操作 Kiro IDE 的会话：会话列表、历史、流式思维链、发送消息、新建会话",
  "version": "0.7.0",
  "publisher": "local",
  "license": "MIT",
  "author": "AMMPNK",
  "keywords": [
    "kiro",
    "acp",
    "remote",
    "mobile",
    "websocket"
  ],
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./src/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "kiroBridge.start",
        "title": "Kiro Bridge: 启动远程会话"
      },
      {
        "command": "kiroBridge.stop",
        "title": "Kiro Bridge: 停止远程会话"
      },
      {
        "command": "kiroBridge.showUrl",
        "title": "Kiro Bridge: 显示访问地址与二维码"
      },
      {
        "command": "kiroBridge.diagnose",
        "title": "Kiro Bridge: 运行自诊断"
      },
      {
        "command": "kiroBridge.probe",
        "title": "Kiro Bridge: 探测 agent 方法"
      },
      {
        "command": "kiroBridge.rotateToken",
        "title": "Kiro Bridge: 轮换访问 token"
      },
      {
        "command": "kiroBridge.showLog",
        "title": "Kiro Bridge: 打开日志"
      }
    ],
    "configuration": {
      "title": "Kiro Remote Bridge",
      "properties": {
        "kiroBridge.port": {
          "type": "number",
          "default": 3939,
          "description": "本地 relay 监听端口"
        },
        "kiroBridge.bindLan": {
          "type": "boolean",
          "default": true,
          "description": "绑定到局域网地址（关闭则只监听 127.0.0.1）"
        },
        "kiroBridge.autoStart": {
          "type": "boolean",
          "default": false,
          "description": "IDE 启动后自动开启远程会话"
        },
        "kiroBridge.debugProbeOnStartup": {
          "type": "boolean",
          "default": false,
          "markdownDescription": "激活后自动跑一次只读诊断，把 mux 端点（含 token）与 agent 方法探测结果写入 `~/.kiro-bridge/`。仅本机排障用；关闭时扩展在你执行 `Kiro Bridge: 启动` 之前不会连接 agent。同样的事可以随时用 `Kiro Bridge: 探测 agent 方法` 命令做一次。"
        }
      }
    }
  },
  "scripts": {
    "test": "node test/run-all.mjs"
  }
}